# ServAI Environment Variables Template

# Backend Configuration
DATABASE_URL=postgresql://postgres:postgres@db:5432/servai
REDIS_URL=redis://redis:6379/0
VECTOR_DB_URL=postgresql://postgres:postgres@db:5432/servai
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gpt-4-turbo-preview
APP_SECRET_KEY=generate_a_random_secret_key_here

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXTAUTH_SECRET=generate_another_secret_here
NEXTAUTH_URL=http://localhost:3000

# Infrastructure
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=servai

# Multi-tenancy / Security
# The application handles setting app.current_business_id for RLS policies
ENCRYPTION_KEY=per_tenant_master_encryption_key_placeholder

# Monitoring
GRAFANA_ADMIN_PASSWORD=admin
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
